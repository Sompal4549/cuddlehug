# --- Server ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cuddlehug

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost

# --- Razorpay (payments) ---
# Leave empty to run in dev-payment mode (only allowed when NODE_ENV != production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Cloudinary (product image hosting) ---
# Leave empty to store images on local disk (development mode)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (transactional email) ---
# Leave empty: emails are logged to the console in development
RESEND_API_KEY=
EMAIL_FROM=CuddleHug <onboarding@resend.dev>

# --- Misc ---
DEFAULT_TAX_RATE=18
DEFAULT_SHIPPING_FEE=79
FREE_SHIPPING_THRESHOLD=1499
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
